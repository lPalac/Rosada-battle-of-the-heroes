{
  "$id": "royal-favors.schema.json",
  "type": "object",
  "required": [
    "favors",
    "powers"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "favors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "once",
              "half",
              "count"
            ]
          },
          "target": {
            "type": "integer",
            "minimum": 2
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "powers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "threshold"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "threshold": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
