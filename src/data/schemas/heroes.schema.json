{
  "$id": "heroes.schema.json",
  "type": "object",
  "required": ["heroes"],
  "properties": {
    "$schema": { "type": "string" },
    "heroes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "rangeType", "movement", "range", "maxHealth", "epicMaxHealth", "healthBar", "abilities", "art"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "rangeType": { "enum": ["short", "long"] },
          "movement": { "type": "integer", "minimum": 1, "maximum": 10 },
          "range": { "type": "integer", "minimum": 1, "maximum": 10 },
          "maxHealth": { "type": "integer", "minimum": 1 },
          "epicMaxHealth": { "type": "integer", "minimum": 1 },
          "healthBar": { "type": "string" },
          "abilities": { "type": "array", "items": { "type": "string" } },
          "art": { "type": "string" }
        }
      }
    }
  }
}
