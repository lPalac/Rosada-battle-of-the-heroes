                    "properties": {
                      "movement": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      }
                    }
                  }
                }
              },
              "dominant": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "portrait",
                  "sheet",
                  "abilities"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "portrait": {
                    "type": "string"
                  },
                  "sheet": {
                    "type": "string"
                  },
                  "abilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "stats": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "movement": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      }
                    }
