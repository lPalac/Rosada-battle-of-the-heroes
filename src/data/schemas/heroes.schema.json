          },
          "portrait": {
            "type": "string"
          },
          "epicArt": {
            "type": "string"
          },
          "selectable": {
            "type": "boolean"
          },
          "sheet": {
            "type": "string"
          },
          "forms": {
            "type": "object",
            "required": [
              "fanatic",
              "resolute",
              "dominant"
            ],
            "additionalProperties": false,
            "properties": {
              "fanatic": {
                "type": "object",
