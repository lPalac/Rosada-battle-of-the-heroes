                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "portrait": {
                    "type": "string"
                  },
                  "sheet": {
                    "type": "string"
                  },
                  "abilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "stats": {
                    "type": "object",
