            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rangeType": {
            "enum": [
              "short",
              "long"
            ]
          },
          "movement": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "range": {
            "type": "integer",
