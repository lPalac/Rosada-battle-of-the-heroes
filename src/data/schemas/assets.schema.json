{
  "$id": "assets.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "object",
    "anyOf": [
      {
        "required": [
          "placeholder"
        ]
      },
      {
        "required": [
          "gltf"
        ]
      },
      {
        "required": [
          "image"
        ]
      },
      {
        "required": [
          "mesh"
        ]
      }
    ],
    "properties": {
      "placeholder": {
        "type": "string"
      },
      "gltf": {
        "type": "string"
      },
      "image": {
        "type": "string"
      },
      "mesh": {
        "type": "string"
      },
      "texture": {
        "type": "string"
      },
      "normal": {
        "type": "string"
      },
      "collider": {
        "type": "string"
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "scale": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "columns": {
        "type": "integer",
        "minimum": 1
      },
      "flipY": {
        "type": "boolean"
      },
      "yaw": {
        "type": "number"
      },
      "offsetY": {
        "type": "number"
      }
    },
    "additionalProperties": false
  }
}
