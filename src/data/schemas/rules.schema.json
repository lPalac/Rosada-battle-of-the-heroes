{
  "$id": "rules.schema.json",
  "$defs": {
    "n": { "type": "integer", "minimum": 0 },
    "offer": { "type": "object", "required": ["cost", "heal"], "properties": { "cost": { "$ref": "#/$defs/n" }, "heal": { "$ref": "#/$defs/n" } } }
  },
  "type": "object",
  "required": ["leadTarget", "die", "modifiers", "ramWounds", "tavern", "maxMovementReduction", "revengeMax", "banishmentMovementPenalty", "destiny", "abilities"],
  "properties": {
    "$schema": { "type": "string" },
    "leadTarget": { "type": "integer", "minimum": 1 },
    "die": { "const": 20 },
    "modifiers": {
      "type": "object", "required": ["war", "kingInCheck", "inspiredLeadPerDestiny"],
      "properties": { "war": { "$ref": "#/$defs/n" }, "kingInCheck": { "$ref": "#/$defs/n" }, "inspiredLeadPerDestiny": { "$ref": "#/$defs/n" } }
    },
    "ramWounds": { "$ref": "#/$defs/n" },
    "tavern": {
      "type": "object", "required": ["drink", "meal", "startTurnMovementPenalty"],
      "properties": { "drink": { "$ref": "#/$defs/offer" }, "meal": { "$ref": "#/$defs/offer" }, "startTurnMovementPenalty": { "$ref": "#/$defs/n" } }
    },
    "maxMovementReduction": { "$ref": "#/$defs/n" },
    "revengeMax": { "$ref": "#/$defs/n" },
    "banishmentMovementPenalty": { "$ref": "#/$defs/n" },
    "destiny": {
      "type": "object",
      "required": ["wellInitial", "heroPoolStart", "check", "destroyEnemy", "ownUnitLost", "woundEnemyHero", "failedLead"],
      "additionalProperties": { "$ref": "#/$defs/n" }
    },
    "abilities": {
      "type": "object", "required": ["heroRetreat"],
      "properties": { "heroRetreat": { "type": "object", "required": ["cost"], "properties": { "cost": { "$ref": "#/$defs/n" } } } }
    }
  }
}
